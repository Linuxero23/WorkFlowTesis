PORT=3000
CORS_ORIGINS=http://localhost:5173

# Reemplaza este valor vacío por un secreto aleatorio local de al menos 32 caracteres.
# PowerShell: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# No subas backend/.env ni compartas el secreto generado.
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=28800

DB_SERVER=localhost
DB_PORT=1435
DB_DATABASE=SynesisDB
DB_USER=your_sql_user
DB_PASSWORD=replace-with-your-local-sql-password
# Para SQL Server local, habilítalo/deshabilítalo según la configuración del certificado.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
